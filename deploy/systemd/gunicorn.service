# /etc/systemd/system/gunicorn.service
# Install:  sudo cp deploy/systemd/gunicorn.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now gunicorn
[Unit]
Description=Gunicorn WSGI server for EPIConnect
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=rayen9
Group=www-data
WorkingDirectory=/var/www/EPIConnect
# .env is loaded by Django itself (python-dotenv); nothing secret lives here.
ExecStart=/var/www/EPIConnect/venv/bin/gunicorn epiconnect.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0002

[Install]
WantedBy=multi-user.target
