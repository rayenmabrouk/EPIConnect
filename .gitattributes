# Shell scripts and container/infra files must keep LF endings even when the
# repository is checked out on Windows (a CRLF entrypoint breaks the container).
* text=auto
*.sh      text eol=lf
*.py      text eol=lf
*.tf      text eol=lf
*.hcl     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
Dockerfile text eol=lf
*.png     binary
