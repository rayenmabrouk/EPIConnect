# Local settings for docker compose (NOT used on AWS: the ECS task definition
# sets these, and secrets come from AWS Secrets Manager).
# Copy to .env for `python manage.py runserver` without Docker.

DEBUG=false
SECRET_KEY=local-compose-only-not-a-real-secret-do-not-use-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# No TLS locally: no HTTPS redirect, no HSTS. Browsers treat localhost as a
# secure context, so the Secure cookie flag still works.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# Serve uploaded files from the local volume (on AWS: S3 + CloudFront)
SERVE_MEDIA=true

# 0 = do not trust X-Forwarded-For (no proxy in front locally)
TRUSTED_PROXY_COUNT=0

# DATABASE_URL is set by compose.yaml. Without it, SQLite is used.
