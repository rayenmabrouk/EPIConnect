# Copy to .env on the server:  cp .env.example .env && nano .env
# Never commit the real .env (it is in .gitignore).

# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=False
ALLOWED_HOSTS=epiconnect.swedencentral.cloudapp.azure.com,4.223.163.106,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://epiconnect.swedencentral.cloudapp.azure.com

# True once the Let's Encrypt certificate is installed.
# Set to False only for a plain-HTTP demo on http://<ip>.
HTTPS=True

# PostgreSQL 16 (leave empty to use SQLite locally)
DATABASE_URL=postgres://epiconnect_user:change-me@localhost:5432/epiconnect_db

TIME_ZONE=Africa/Tunis
